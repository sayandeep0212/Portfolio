# ==============================================================================
# Sayandeep Pradhan Portfolio — Environment Configuration Template
# Copy this file to `.env.local` and populate your secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Firestore Analytics & View Counter
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="portfolio-2b013.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="portfolio-2b013"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="portfolio-2b013.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# ------------------------------------------------------------------------------
# 2. Spotify Web API (Real-Time Playback & Recently Played Tracks)
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"
SPOTIFY_REFRESH_TOKEN="your_spotify_refresh_token"

# ------------------------------------------------------------------------------
# 3. GitHub Personal Access Token (for Activity Graph & Commit Hashes)
# ------------------------------------------------------------------------------
GITHUB_PAT="your_github_pat_token"

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 Bucket (Media Upload for Stories, Projects, Gallery, max 25MB)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="sayandeep-portfolio"
R2_PUBLIC_URL="https://pub-yourhash.r2.dev"

# ------------------------------------------------------------------------------
# 5. EmailJS (Auto-reply confirmation sent to visitor when they submit message)
# ------------------------------------------------------------------------------
EMAILJS_SERVICE_ID="your_emailjs_service_id"
EMAILJS_TEMPLATE_ID="template_ujvxg0n"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_PRIVATE_KEY="your_emailjs_private_key"
NEXT_PUBLIC_EMAILJS_SERVICE_ID="your_emailjs_service_id"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID="template_ujvxg0n"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="your_emailjs_public_key"


